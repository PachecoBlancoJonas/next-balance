# Server
PORT=5000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_USER=next_balance
DB_PASSWORD=your_db_password
DB_NAME=next_balance

# Auth
JWT_SECRET=a_long_random_secret_string

# GoCardless Bank Account Data API
# Get your credentials at: https://bankaccountdata.gocardless.com/user-secrets/
SECRET_ID=your_gocardless_secret_id
SECRET_KEY=your_gocardless_secret_key
GOCARDLESS_API_BASE_URL=https://bankaccountdata.gocardless.com/api/v2

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
